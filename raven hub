local ui = createGui()

local function showPopup(show)
    ui.confirmPopup.Visible = show
end

local function startFlying(rootPart)
    if not rootPart then
        return
    end

    flying = true
    ui.setFlyState(true)

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.Name = "FlyBodyVelocity"
    bodyVelocity.MaxForce = Vector3.new(500000, 500000, 500000)
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.Name = "FlyBodyGyro"
    bodyGyro.MaxTorque = Vector3.new(400000, 400000, 400000)
    bodyGyro.CFrame = rootPart.CFrame
    bodyGyro.Parent = rootPart
end

local function stopFlying()
    flying = false
    ui.setFlyState(false)

    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end
    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end
end

local function toggleFly()
    local char = player.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        return
    end
    if flying then
        stopFlying()
    else
        startFlying(rootPart)
    end
end

local function updateEsp()
    for _, adorn in pairs(espAdornments) do
        if adorn and adorn.Parent then
            adorn:Destroy()
        end
    end
    espAdornments = {}

    if not espEnabled then
        return
    end

    for _, otherPlayer in pairs(Players:GetPlayers()) do
        createEspForPlayer(otherPlayer)
    end
end

local function toggleEsp()
    espEnabled = not espEnabled
    ui.setEspState(espEnabled)
    updateEsp()
end

local function toggleMenu()
    ui.screenGui.Enabled = not ui.screenGui.Enabled
end

