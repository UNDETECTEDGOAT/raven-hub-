    end
end)

ui.flyToggleButton.MouseButton1Click:Connect(toggleFly)
ui.espToggleButton.MouseButton1Click:Connect(toggleEsp)

ui.menuKeyButton.MouseButton1Click:Connect(function()
    if not active then
        return
    end
    awaitingKey = true
    ui.setMenuKeyText("PRESS KEY")
end)

for _, otherPlayer in pairs(Players:GetPlayers()) do
    bindEspTrackingForPlayer(otherPlayer)
end

Players.PlayerAdded:Connect(function(newPlayer)
    bindEspTrackingForPlayer(newPlayer)
end)

ui.titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        dragOffset = Vector2.new(ui.mainFrame.Position.X.Offset, ui.mainFrame.Position.Y.Offset)
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        ui.mainFrame.Position = UDim2.new(0, dragOffset.X + (input.Position.X - dragStart.X), 0, dragOffset.Y + (input.Position.Y - dragStart.Y))
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not active then
        return
    end
    if input.UserInputType == Enum.UserInputType.Keyboard then
        if awaitingKey and input.KeyCode ~= Enum.KeyCode.Unknown then
            menuKey = input.KeyCode
            ui.setMenuKeyText(menuKey.Name)
            awaitingKey = false
            return
        end
        if input.KeyCode == menuKey then
            toggleMenu()
        elseif input.KeyCode == Enum.KeyCode.Space then
            ascending = true
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if not active then
        return
    end
    if input.KeyCode == Enum.KeyCode.Space then
        ascending = false
    end
end)

RunService.Heartbeat:Connect(function()
    if not active then
        return
    end
    if flying and bodyVelocity then
        local char = player.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        local moveDir = humanoid and humanoid.MoveDirection or Vector3.new()
        local velocity = moveDir * flySpeed
        if ascending then
            velocity = velocity + Vector3.new(0, flySpeed, 0)
        end
        bodyVelocity.Velocity = velocity
    end
    if espEnabled then
        for otherPlayer, adorn in pairs(espAdornments) do
            if not otherPlayer.Parent or not adorn.Parent then
                espAdornments[otherPlayer] = nil
            end
        end
    end
end)

player.CharacterAdded:Connect(function()
    stopFlying()
    if espEnabled then
        updateEsp()
    end
end)

Players.PlayerRemoving:Connect(function(removed)
    local adorn = espAdornments[removed]
    if adorn then
        adorn:Destroy()
        espAdornments[removed] = nil
    end

    local conn = espConnections[removed]
    if conn then
        conn:Disconnect()
        espConnections[removed] = nil
    end
end)
