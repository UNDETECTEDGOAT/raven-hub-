    local function updateFlySpeedFromX(x)
        local trackPos = sliderTrack.AbsolutePosition.X
        local trackSize = sliderTrack.AbsoluteSize.X
        local localX = math.clamp(x - trackPos, 0, trackSize)
        local percent = localX / trackSize
        flySpeed = math.floor(flySpeedMin + (flySpeedMax - flySpeedMin) * percent + 0.5)
        sliderFill.Size = UDim2.new(percent, 0, 1, 0)
        sliderHandle.Position = UDim2.new(percent, -9, 0.5, -9)
        flySpeedValue.Text = tostring(flySpeed)
    end

